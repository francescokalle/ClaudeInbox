# ClaudeInbox — template di configurazione.
# Copialo in ~/.claude/claude-mail.env (chmod 600) e compilalo, oppure usa il
# wizard: python3 bin/setup_web.py  (consigliato).
# NON committare il file con i valori reali.

# --- Invio (SMTP) ---
SMTP_HOST=smtp.provider.com
SMTP_PORT=587                 # 587 = STARTTLS, 465 = SSL/TLS
SMTP_SECURITY=starttls        # starttls | ssl | (vuoto = dedotto dalla porta)
SMTP_LOGIN=
SMTP_PASSWORD=

# --- Indirizzi ---
MAIL_SENDER=claude@tuo-dominio.com      # da cui Claude invia
MAIL_RECIPIENT=tu@tuo-dominio.com       # dove ricevi le notifiche

# --- Backend di lettura risposte ---
# imap    = leggi da una casella IMAP esterna (gestore email)
# maildir = leggi dal Maildir locale riempito dal ricevitore self-hosted
#           (server dietro CGNAT + tunnel cloudflared + Email Worker)
# http    = tira le risposte dall'endpoint /pull del ricevitore remoto
#           (usalo sulla macchina con la CLI `claude`, es. il laptop)
INBOX_BACKEND=imap

# --- Opzione A: IMAP (gestore esterno) ---
# Usa una casella DEDICATA a Claude (non la tua posta personale) e instrada lì le
# risposte a MAIL_SENDER. Serve solo se INBOX_BACKEND=imap.
IMAP_HOST=          # es. imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=      # per Gmail: app password, senza spazi

# --- Opzione B: ricevitore self-hosted (INBOX_BACKEND=maildir), lato SERVER ---
# Il receiver HTTP (bin/receiver.py) salva qui le mail spinte dall'Email Worker.
MAILDIR_PATH=~/.claude/claudeinbox-maildir
RECEIVER_PORT=8899
RECEIVER_TOKEN=     # segreto condiviso col Worker; genera con: python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# --- Opzione C: lettura remota via /pull (INBOX_BACKEND=http), lato CLIENT ---
# Sulla macchina con `claude` (es. laptop): tira le risposte dal receiver remoto.
PULL_URL=https://inbox.tuodominio.com/pull
# RECEIVER_TOKEN qui deve essere lo STESSO del receiver/Worker.
